# Copy this file to .env and fill in your own keys. Never commit .env.

# Gnani voice models (get a key at https://app.gnani.ai)
GNANI_API_KEY=
# GNANI_STT_MODEL=prisma-v3.0
# GNANI_TTS_MODEL=timbre-v3.0
# GNANI_TTS_VOICE=Shivani

# Optional: lets the app read photos of documents and reply in more languages
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Optional: send claim details to the Insurithm AI agent
INSURITHM_URL=
